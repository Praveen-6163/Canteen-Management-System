{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/api/$1"
    },
    {
      "source": "/admin/login",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/admin/dashboard(.*)",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/dashboard(.*)",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/signup(.*)",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
